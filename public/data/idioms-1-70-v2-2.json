[{"num":11,"id":"不翼而飞","pinyin":"bù yì ér fēi","explain":"东西忽然不见了。","usage":"Use it for an object that suddenly goes missing.","english":"Disappear without a trace.","characters":[{"char":"不","gloss":"没有","icon":"⛔"},{"char":"翼","gloss":"翅膀","icon":"🪽"},{"char":"而","gloss":"却","icon":"⭐"},{"char":"飞","gloss":"飞走","icon":"🪽"}],"exampleParts":{"before":"那本","idiom":"不翼而飞","collocation":"的笔记本","after":"最后竟在窗边找到了。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":0,"sliceWidth":420,"sliceHeight":344}},{"num":12,"id":"不知所措","pinyin":"bù zhī suǒ cuò","explain":"慌乱得不知道怎么办。","usage":"Use it for a person who is confused or panicked and does not know what to do.","english":"Be at a loss.","characters":[{"char":"不","gloss":"不","icon":"⛔"},{"char":"知","gloss":"知道","icon":"⭐"},{"char":"所","gloss":"怎样","icon":"⭐"},{"char":"措","gloss":"处理","icon":"⭐"}],"exampleParts":{"before":"突然停电时，他一时","idiom":"不知所措","collocation":"地站着","after":"，后来才冷静下来。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":1,"sliceWidth":420,"sliceHeight":344}},{"num":13,"id":"不自量力","pinyin":"bù zì liàng lì","explain":"高估自己的能力。","usage":"Use it for a person who tries something far beyond their ability.","english":"Overestimate one’s ability.","characters":[{"char":"不","gloss":"不","icon":"⛔"},{"char":"自","gloss":"自己","icon":"⭐"},{"char":"量","gloss":"估量","icon":"⭐"},{"char":"力","gloss":"能力","icon":"⭐"}],"exampleParts":{"before":"刚学游泳就挑战深水区，真是","idiom":"不自量力","collocation":"地逞强","after":"。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":2,"sliceWidth":420,"sliceHeight":344}},{"num":14,"id":"差强人意","pinyin":"chā qiáng rén yì","explain":"大体上还能让人满意。","usage":"Use it for a result or performance that is acceptable, though not excellent.","english":"Fairly satisfactory.","characters":[{"char":"差","gloss":"稍微","icon":"⭐"},{"char":"强","gloss":"振奋","icon":"⭐"},{"char":"人","gloss":"人","icon":"👥"},{"char":"意","gloss":"心意","icon":"❤️"}],"exampleParts":{"before":"这次比赛，他取得了","idiom":"差强人意","collocation":"的成绩","after":"，虽不完美但还算可以。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":3,"sliceWidth":420,"sliceHeight":344}},{"num":15,"id":"长年累月","pinyin":"cháng nián lěi yuè","explain":"经过很长的年月。","usage":"Use it for an action or condition that continues for a very long time.","english":"Over many years.","characters":[{"char":"长","gloss":"长久","icon":"⭐"},{"char":"年","gloss":"年","icon":"🕰️"},{"char":"累","gloss":"累积","icon":"⭐"},{"char":"月","gloss":"月","icon":"🕰️"}],"exampleParts":{"before":"他","idiom":"长年累月","collocation":"地坚持","after":"阅读，词汇量越来越丰富。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":4,"sliceWidth":420,"sliceHeight":344}},{"num":16,"id":"长袖善舞","pinyin":"cháng xiù shàn wǔ","explain":"善于应酬和钻营。","usage":"Use it, often negatively, for a person who gains advantages through clever social dealings.","english":"Be skilled at social maneuvering.","characters":[{"char":"长","gloss":"长","icon":"⭐"},{"char":"袖","gloss":"衣袖","icon":"⭐"},{"char":"善","gloss":"善于","icon":"⭐"},{"char":"舞","gloss":"舞动","icon":"⭐"}],"exampleParts":{"before":"他凭着","idiom":"长袖善舞","collocation":"的手腕","after":"到处拉关系，让人不太放心。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":5,"sliceWidth":420,"sliceHeight":344}},{"num":17,"id":"嗤之以鼻","pinyin":"chī zhī yǐ bí","explain":"用冷笑表示轻视。","usage":"Use it for a person’s scornful reaction to an idea, person or thing.","english":"Turn up one’s nose at something.","characters":[{"char":"嗤","gloss":"冷笑","icon":"🙂"},{"char":"之","gloss":"对它","icon":"⭐"},{"char":"以","gloss":"用","icon":"⭐"},{"char":"鼻","gloss":"鼻子","icon":"👃"}],"exampleParts":{"before":"他对新方法抱着","idiom":"嗤之以鼻","collocation":"的态度","after":"，连试都不肯试。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":6,"sliceWidth":420,"sliceHeight":344}},{"num":18,"id":"持之以恒","pinyin":"chí zhī yǐ héng","explain":"长久坚持不放弃。","usage":"Use it for steady effort that continues for a long time.","english":"Persevere over time.","characters":[{"char":"持","gloss":"坚持","icon":"⭐"},{"char":"之","gloss":"它","icon":"⭐"},{"char":"以","gloss":"用","icon":"⭐"},{"char":"恒","gloss":"恒心","icon":"❤️"}],"exampleParts":{"before":"学华文要","idiom":"持之以恒","collocation":"地练习","after":"，每天进步一点。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":7,"sliceWidth":420,"sliceHeight":344}},{"num":19,"id":"重蹈覆辙","pinyin":"chóng dǎo fù zhé","explain":"不吸取教训，又犯同样错误。","usage":"Use it for repeating a past mistake because the lesson was not learned.","english":"Repeat the same mistake.","characters":[{"char":"重","gloss":"再次","icon":"⭐"},{"char":"蹈","gloss":"踩上","icon":"⭐"},{"char":"覆","gloss":"翻车","icon":"⭐"},{"char":"辙","gloss":"车辙","icon":"⭐"}],"exampleParts":{"before":"如果不改正，就有","idiom":"重蹈覆辙","collocation":"的危险","after":"，还会犯同样错误。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":8,"sliceWidth":420,"sliceHeight":344}},{"num":20,"id":"出尔反尔","pinyin":"chū ěr fǎn ěr","explain":"说话做事反复无常。","usage":"Use it for a person whose words or promises keep changing.","english":"Go back on one’s word.","characters":[{"char":"出","gloss":"说出","icon":"⭐"},{"char":"尔","gloss":"你","icon":"⭐"},{"char":"反","gloss":"反过来","icon":"⭐"},{"char":"尔","gloss":"你","icon":"⭐"}],"exampleParts":{"before":"他这种","idiom":"出尔反尔","collocation":"的做法","after":"，让大家不再相信他。"},"comic":{"sprite":"assets/chengyu/v2/idioms-11-20.webp","index":9,"sliceWidth":420,"sliceHeight":344}}]