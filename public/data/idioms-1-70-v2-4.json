[{"num":31,"id":"当仁不让","pinyin":"dāng rén bù ràng","explain":"该做的好事，主动去做。","usage":"Use it for a person who steps forward to do what is right and necessary.","english":"Take responsibility for a right cause.","characters":[{"char":"当","gloss":"面对","icon":"⭐"},{"char":"仁","gloss":"正义","icon":"⭐"},{"char":"不","gloss":"不","icon":"⛔"},{"char":"让","gloss":"推让","icon":"⭐"}],"exampleParts":{"before":"看到同学需要帮忙，他","idiom":"当仁不让","collocation":"地站出来","after":"伸出援手。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":0,"sliceWidth":420,"sliceHeight":344}},{"num":32,"id":"道貌岸然","pinyin":"dào mào àn rán","explain":"外表正经，实际并不正派。","usage":"Use it negatively for a person who pretends to be proper while behaving badly.","english":"Look respectable but act badly.","characters":[{"char":"道","gloss":"正经","icon":"⭐"},{"char":"貌","gloss":"外貌","icon":"⭐"},{"char":"岸","gloss":"严肃","icon":"⭐"},{"char":"然","gloss":"样子","icon":"🧭"}],"exampleParts":{"before":"他摆出","idiom":"道貌岸然","collocation":"的样子","after":"，背后却偷偷作弊。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":1,"sliceWidth":420,"sliceHeight":344}},{"num":33,"id":"德高望重","pinyin":"dé gāo wàng zhòng","explain":"品德高尚，声望很高。","usage":"Use it respectfully for an experienced person with strong moral standing.","english":"Highly respected for virtue and reputation.","characters":[{"char":"德","gloss":"品德","icon":"⭐"},{"char":"高","gloss":"高尚","icon":"⭐"},{"char":"望","gloss":"声望","icon":"🏅"},{"char":"重","gloss":"很高","icon":"⭐"}],"exampleParts":{"before":"这位","idiom":"德高望重","collocation":"的老校友","after":"一直受到师生敬重。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":2,"sliceWidth":420,"sliceHeight":344}},{"num":34,"id":"得过且过","pinyin":"dé guò qiě guò","explain":"只求过得去，不求进步。","usage":"Use it for a person who settles for the minimum and avoids improvement.","english":"Muddle along without ambition.","characters":[{"char":"得","gloss":"能过","icon":"⭐"},{"char":"过","gloss":"过日子","icon":"⭐"},{"char":"且","gloss":"暂且","icon":"⭐"},{"char":"过","gloss":"继续过","icon":"⭐"}],"exampleParts":{"before":"他每天只做最低要求，过着","idiom":"得过且过","collocation":"的日子","after":"，成绩一直没进步。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":3,"sliceWidth":420,"sliceHeight":344}},{"num":35,"id":"得意忘形","pinyin":"dé yì wàng xíng","explain":"太得意而失去常态。","usage":"Use it for a person who becomes overexcited or arrogant after success.","english":"Get carried away by success.","characters":[{"char":"得","gloss":"得到","icon":"⭐"},{"char":"意","gloss":"满意","icon":"⭐"},{"char":"忘","gloss":"忘记","icon":"⭐"},{"char":"形","gloss":"常态","icon":"⭐"}],"exampleParts":{"before":"刚拿到奖，他就","idiom":"得意忘形","collocation":"地庆祝","after":"，差点忘了礼貌。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":4,"sliceWidth":420,"sliceHeight":344}},{"num":36,"id":"掉以轻心","pinyin":"diào yǐ qīng xīn","explain":"对事情太轻率，不够小心。","usage":"Use it for careless attitudes toward a task, risk or problem.","english":"Take something too lightly.","characters":[{"char":"掉","gloss":"轻忽","icon":"⭐"},{"char":"以","gloss":"用","icon":"⭐"},{"char":"轻","gloss":"轻率","icon":"⭐"},{"char":"心","gloss":"心态","icon":"❤️"}],"exampleParts":{"before":"考试前若抱着","idiom":"掉以轻心","collocation":"的态度","after":"，很容易漏掉重要细节。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":5,"sliceWidth":420,"sliceHeight":344}},{"num":37,"id":"独善其身","pinyin":"dú shàn qí shēn","explain":"只顾自己，不管别人。","usage":"Use it for a person who protects only their own interests and ignores others.","english":"Look after oneself only.","characters":[{"char":"独","gloss":"只顾","icon":"⭐"},{"char":"善","gloss":"保全","icon":"⭐"},{"char":"其","gloss":"自己","icon":"⭐"},{"char":"身","gloss":"自身","icon":"⭐"}],"exampleParts":{"before":"小组遇到困难时，不能抱着","idiom":"独善其身","collocation":"的想法","after":"只顾自己。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":6,"sliceWidth":420,"sliceHeight":344}},{"num":38,"id":"对牛弹琴","pinyin":"duì niú tán qín","explain":"说话不看对象，对方听不懂。","usage":"Use it when someone explains something to a person who cannot understand or appreciate it.","english":"Speak to the wrong audience.","characters":[{"char":"对","gloss":"面对","icon":"⭐"},{"char":"牛","gloss":"牛","icon":"🐮"},{"char":"弹","gloss":"弹奏","icon":"⭐"},{"char":"琴","gloss":"琴","icon":"🎵"}],"exampleParts":{"before":"用太难的术语解释基础题，就像","idiom":"对牛弹琴","collocation":"一样","after":"，对方很难听懂。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":7,"sliceWidth":420,"sliceHeight":344}},{"num":39,"id":"对症下药","pinyin":"duì zhèng xià yào","explain":"针对问题采取合适办法。","usage":"Use it for solving a problem with a method that directly matches its cause.","english":"Apply the right remedy to a problem.","characters":[{"char":"对","gloss":"针对","icon":"🪡"},{"char":"症","gloss":"问题","icon":"💬"},{"char":"下","gloss":"使用","icon":"⭐"},{"char":"药","gloss":"方法","icon":"⭐"}],"exampleParts":{"before":"找到错误原因后，他","idiom":"对症下药","collocation":"地调整","after":"学习方法。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":8,"sliceWidth":420,"sliceHeight":344}},{"num":40,"id":"多多益善","pinyin":"duō duō yì shàn","explain":"数量越多越好。","usage":"Use it when having a larger amount is considered beneficial.","english":"The more, the better.","characters":[{"char":"多","gloss":"多","icon":"🔢"},{"char":"多","gloss":"更多","icon":"🔢"},{"char":"益","gloss":"更加","icon":"⭐"},{"char":"善","gloss":"好","icon":"⭐"}],"exampleParts":{"before":"募集旧书时，数量当然","idiom":"多多益善","collocation":"，越多越好","after":"。"},"comic":{"sprite":"assets/chengyu/v2/idioms-31-40.webp","index":9,"sliceWidth":420,"sliceHeight":344}}]