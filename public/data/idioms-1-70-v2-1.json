[{"num":1,"id":"百折不挠","pinyin":"bǎi zhé bù náo","explain":"多次受挫，也不放弃。","usage":"Use it for a person’s perseverance in difficult tasks.","english":"Keep going after repeated setbacks.","characters":[{"char":"百","gloss":"很多次","icon":"🔢"},{"char":"折","gloss":"受挫","icon":"⛔"},{"char":"不","gloss":"不会","icon":"⛔"},{"char":"挠","gloss":"屈服","icon":"⭐"}],"exampleParts":{"before":"面对一次次失败，他仍","idiom":"百折不挠","collocation":"地练习","after":"，最后进步很大。"},"comic":{"sprite":"assets/chengyu/v2/idioms-01-10.webp","index":0,"sliceWidth":480,"sliceHeight":393}},{"num":2,"id":"班门弄斧","pinyin":"bān mén nòng fǔ","explain":"在行家面前卖弄本领。","usage":"Use it for speech or actions that show off skills before an expert.","english":"Show off before an expert.","characters":[{"char":"班","gloss":"鲁班","icon":"⭐"},{"char":"门","gloss":"门前","icon":"🚪"},{"char":"弄","gloss":"舞弄","icon":"🪓"},{"char":"斧","gloss":"斧头","icon":"🛠️"}],"exampleParts":{"before":"他竟在书法高手面前","idiom":"班门弄斧","collocation":"地卖弄","after":"技巧，反而闹了笑话。"},"comic":{"sprite":"assets/chengyu/v2/idioms-01-10.webp","index":1,"sliceWidth":480,"sliceHeight":393}},{"num":3,"id":"半途而废","pinyin":"bàn tú ér fèi","explain":"事情做到一半就放弃。","usage":"Use it for a task or plan that is started but not finished.","english":"Give up halfway.","characters":[{"char":"半","gloss":"一半","icon":"🔢"},{"char":"途","gloss":"路途","icon":"🛣️"},{"char":"而","gloss":"却","icon":"⭐"},{"char":"废","gloss":"停止","icon":"⛔"}],"exampleParts":{"before":"养成","idiom":"半途而废","collocation":"的习惯","after":"，做什么都难有成果。"},"comic":{"sprite":"assets/chengyu/v2/idioms-01-10.webp","index":2,"sliceWidth":480,"sliceHeight":393}},{"num":4,"id":"悲天悯人","pinyin":"bēi tiān mǐn rén","explain":"怜惜别人的痛苦。","usage":"Use it for a person’s compassionate feelings toward people in hardship.","english":"Feel deep compassion for others.","characters":[{"char":"悲","gloss":"哀叹","icon":"⭐"},{"char":"天","gloss":"世间","icon":"⭐"},{"char":"悯","gloss":"怜惜","icon":"❤️"},{"char":"人","gloss":"人们","icon":"👥"}],"exampleParts":{"before":