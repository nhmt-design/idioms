[{"num":51,"id":"赴汤蹈火","pinyin":"fù tāng dǎo huǒ","explain":"不怕艰险，奋勇向前。","usage":"Use it for courageous action that faces serious danger or hardship for others or a cause.","english":"Brave danger for a worthy cause.","characters":[{"char":"赴","gloss":"前往","icon":"⭐"},{"char":"汤","gloss":"沸水","icon":"🌊"},{"char":"蹈","gloss":"踩踏","icon":"⭐"},{"char":"火","gloss":"烈火","icon":"🔥"}],"exampleParts":{"before":"救援人员有","idiom":"赴汤蹈火","collocation":"的勇气","after":"，愿意进入危险地区救人。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":0,"sliceWidth":420,"sliceHeight":344}},{"num":52,"id":"改过自新","pinyin":"gǎi guò zì xīn","explain":"改正错误，重新做人。","usage":"Use it for a person who sincerely corrects serious past mistakes and starts anew.","english":"Turn over a new leaf.","characters":[{"char":"改","gloss":"改正","icon":"⭐"},{"char":"过","gloss":"错误","icon":"⛔"},{"char":"自","gloss":"自觉","icon":"⭐"},{"char":"新","gloss":"重新","icon":"⭐"}],"exampleParts":{"before":"犯错后，他下定","idiom":"改过自新","collocation":"的决心","after":"，认真重新开始。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":1,"sliceWidth":420,"sliceHeight":344}},{"num":53,"id":"改邪归正","pinyin":"gǎi xié guī zhèng","explain":"离开邪路，回到正路。","usage":"Use it for a person who leaves a harmful or wrongful way of life and becomes good again.","english":"Return from wrongdoing to the right path.","characters":[{"char":"改","gloss":"改变","icon":"⭐"},{"char":"邪","gloss":"邪路","icon":"🛣️"},{"char":"归","gloss":"回到","icon":"⭐"},{"char":"正","gloss":"正路","icon":"🛣️"}],"exampleParts":{"before":"大家愿意给他","idiom":"改邪归正","collocation":"的机会","after":"，只要他真心改正。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":2,"sliceWidth":420,"sliceHeight":344}},{"num":54,"id":"高瞻远瞩","pinyin":"gāo zhān yuǎn zhǔ","explain":"眼光远，想得长远。","usage":"Use it for long-term planning, vision or decisions that look beyond the present.","english":"Have foresight.","characters":[{"char":"高","gloss":"高处","icon":"👁️"},{"char":"瞻","gloss":"远望","icon":"👁️"},{"char":"远","gloss":"远处","icon":"👁️"},{"char":"瞩","gloss":"注视","icon":"👁️"}],"exampleParts":{"before":"校长","idiom":"高瞻远瞩","collocation":"地规划","after":"未来课程，让学生提早准备新技能。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":3,"sliceWidth":420,"sliceHeight":344}},{"num":55,"id":"高枕无忧","pinyin":"gāo zhěn wú yōu","explain":"没有顾虑，可以安心。","usage":"Use it for a situation where worries have been removed; it can also warn against overconfidence.","english":"Be free from worry.","characters":[{"char":"高","gloss":"高","icon":"⭐"},{"char":"枕","gloss":"枕头","icon":"🛋️"},{"char":"无","gloss":"没有","icon":"⛔"},{"char":"忧","gloss":"忧虑","icon":"⭐"}],"exampleParts":{"before":"准备充分后，他终于能","idiom":"高枕无忧","collocation":"地休息","after":"一下。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":4,"sliceWidth":420,"sliceHeight":344}},{"num":56,"id":"各有千秋","pinyin":"gè yǒu qiān qiū","explain":"各有各的长处和特色。","usage":"Use it when comparing people, works or choices with different advantages.","english":"Each has its own strengths.","characters":[{"char":"各","gloss":"各自","icon":"⭐"},{"char":"有","gloss":"拥有","icon":"⭐"},{"char":"千","gloss":"千年","icon":"🔢"},{"char":"秋","gloss":"岁月","icon":"🕰️"}],"exampleParts":{"before":"这两份","idiom":"各有千秋","collocation":"的作品","after":"让评审很难取舍。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":5,"sliceWidth":420,"sliceHeight":344}},{"num":57,"id":"根深蒂固","pinyin":"gēn shēn dì gù","explain":"基础深，难以动摇。","usage":"Use it for beliefs, habits, impressions or influence that are deeply established.","english":"Deep-rooted and hard to change.","characters":[{"char":"根","gloss":"根基","icon":"🌳"},{"char":"深","gloss":"深","icon":"⭐"},{"char":"蒂","gloss":"根蒂","icon":"🌳"},{"char":"固","gloss":"牢固","icon":"🌳"}],"exampleParts":{"before":"这个","idiom":"根深蒂固","collocation":"的观念","after":"存在多年，很难一下改变。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":6,"sliceWidth":420,"sliceHeight":344}},{"num":58,"id":"功亏一篑","pinyin":"gōng kuī yī kuì","explain":"只差最后一点却失败。","usage":"Use it for work that is almost complete but fails because of a final mistake or omission.","english":"Fail at the last step.","characters":[{"char":"功","gloss":"成果","icon":"⭐"},{"char":"亏","gloss":"缺少","icon":"⭐"},{"char":"一","gloss":"一","icon":"⭐"},{"char":"篑","gloss":"土筐","icon":"⭐"}],"exampleParts":{"before":"最后一步出错，留下","idiom":"功亏一篑","collocation":"的遗憾","after":"，实在可惜。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":7,"sliceWidth":420,"sliceHeight":344}},{"num":59,"id":"勾心斗角","pinyin":"gōu xīn dòu jiǎo","explain":"彼此耍心机，明争暗斗。","usage":"Use it negatively for people who secretly compete, plot or undermine each other.","english":"Scheme and fight against one another.","characters":[{"char":"勾","gloss":"勾连","icon":"⭐"},{"char":"心","gloss":"心计","icon":"❤️"},{"char":"斗","gloss":"争斗","icon":"⭐"},{"char":"角","gloss":"角力","icon":"⭐"}],"exampleParts":{"before":"小组若总有","idiom":"勾心斗角","collocation":"的行为","after":"，合作一定会失败。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":8,"sliceWidth":420,"sliceHeight":344}},{"num":60,"id":"苟且偷安","pinyin":"gǒu qiě tōu ān","explain":"只图眼前安逸，不顾将来。","usage":"Use it negatively for a person who avoids effort for present comfort despite future consequences.","english":"Seek temporary ease and ignore the future.","characters":[{"char":"苟","gloss":"得过且过","icon":"⭐"},{"char":"且","gloss":"暂且","icon":"⭐"},{"char":"偷","gloss":"只图","icon":"⭐"},{"char":"安","gloss":"安逸","icon":"🛋️"}],"exampleParts":{"before":"面对考试，不能抱着","idiom":"苟且偷安","collocation":"的心态","after":"，否则以后更辛苦。"},"comic":{"sprite":"assets/chengyu/v2/idioms-51-60.webp","index":9,"sliceWidth":420,"sliceHeight":344}}]