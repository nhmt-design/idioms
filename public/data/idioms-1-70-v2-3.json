.","characters":[{"char":"大","gloss":"大","icon":"⭐"},{"char":"公","gloss":"公正","icon":"🛡️"},{"char":"无","gloss":"没有","icon":"⛔"},{"char":"私","gloss":"私心","icon":"❤️"}],"exampleParts":{"before":"担任裁判时，他","idiom":"大公无私","collocation":"地评分","after":"，不偏袒朋友。"},"comic":{"sprite":"assets/chengyu/v2/idioms-21-30.webp","index":7,"sliceWidth":420,"sliceHeight":344}},{"num":29,"id":"大言不惭","pinyin":"dà yán bù cán","explain":"说大话还不觉得惭愧。","usage":"Use it for exaggerated boasting or claims made without embarrassment.","english":"Boast shamelessly.","characters":[{"char":"大","gloss":"夸大","icon":"⭐"},{"char":"言","gloss":"话语","icon":"⭐"},{"char":"不","gloss":"不","icon":"⛔"},{"char":"惭","gloss":"惭愧","icon":"⭐"}],"exampleParts":{"before":"他还没练习就","idiom":"大言不惭","collocation":"地夸口","after":"说一定拿冠军。"},"comic":{"sprite":"assets/chengyu/v2/idioms-21-30.webp","index":8,"sliceWidth":420,"sliceHeight":344}},{"num":30,"id":"当机立断","pinyin":"dāng jī lì duàn","explain":"在关键时刻马上作决定。","usage":"Use it for a person who decides quickly and firmly at a critical moment.","english":"Make a prompt decision.","characters":[{"char":"当","gloss":"面对","icon":"⭐"},{"char":"机","gloss":"时机","icon":"⭐"},{"char":"立","gloss":"立即","icon":"⭐"},{"char":"断","gloss":"决断","icon":"⭐"}],"exampleParts":{"before":"发现设备冒烟，他","idiom":"当机立断","collocation":"地关闭","after":"电源并报告老师。"},"comic":{"sprite":"assets/chengyu/v2/idioms-21-30.webp","index":9,"sliceWidth":420,"sliceHeight":344}}]